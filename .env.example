# Copy this file to .env (git-ignored) and fill in your values. Never commit .env.
# Read by luxtrade.agents.llm.default_llm() via python-dotenv.

# LLM provider: openai (default, gpt-4.1-mini) or anthropic (claude-sonnet-4-6).
# A key is needed for free questions, the optimiser and LLM insights; presets work without one.
LUXTRADE_LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override the provider's default model
# LUXTRADE_LLM_MODEL=gpt-4.1-mini

# Optional: alternative locations for the semantic-layer database and run records
# LUXTRADE_DB=data/processed/luxtrade.duckdb
# LUXTRADE_RUNS_DIR=data/runs

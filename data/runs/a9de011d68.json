 "suggestions": [],
 "missing_hint": "",
 "sql": "SELECT\n  year,\n  flow,\n  SUM(value_eur) AS value_eur,\n  SUM(qty_kg) AS qty_kg\nFROM v_lu_trade_hs2\nWHERE\n  period >= CAST('2023-01-01' AS DATE)\n  AND period < CAST('2025-01-01' AS DATE)\n  AND flow = 'export'\n  AND hs2 IN ('72')\nGROUP BY\n  year,\n  flow\nORDER BY\n  year\nLIMIT 10000",
 "custom_sql": false,

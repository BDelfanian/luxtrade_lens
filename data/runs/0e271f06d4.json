 "entities": {},
 "insight": [
  "Luxembourg's exports have increased from 10.80 billion euros in 2002 to a projected 16.25 billion euros in 2025.",
  "This represents a growth of 50.5 percent over the period.",
  "Imports have grown even more, from 13.38 billion euros in 2002 to a projected 25.10 billion euros in 2025, an increase of 87.6 percent.",
  "The peak for exports was in 2006 at 18.34 billion euros, while imports peaked in 2022 at 25.66 billion euros.",
  "The data are presented in current euros and do not account for inflation or price changes."
 ],

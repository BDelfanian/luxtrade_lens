 "sql": "SELECT\n  period AS period,\n  flow,\n  SUM(value_eur) AS value_eur,\n  SUM(qty_kg) AS qty_kg\nFROM v_lu_trade_hs2\nWHERE\n  period >= CAST('2026-01-01' AS DATE)\n  AND period < CAST('2026-07-01' AS DATE)\n  AND flow = 'export'\nGROUP BY\n  period,\n  flow\nORDER BY\n  period\nLIMIT 10000",

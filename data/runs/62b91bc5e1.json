 "suggestions": [],
 "missing_hint": "",
 "sql": "WITH imports_cn AS (\n  SELECT\n    period,\n    SUM(value_eur) AS import_value\n  FROM v_lu_trade\n  WHERE\n    partner = 'CN' AND flow = 'import' AND period <= CAST('2026-06-01' AS DATE)\n  GROUP BY\n    period\n), exports_fr AS (\n  SELECT\n    period,\n    SUM(value_eur) AS export_value\n  FROM v_lu_trade\n  WHERE\n    partner = 'FR' AND flow = 'export' AND period <= CAST('2026-06-01' AS DATE)\n  GROUP BY\n    period\n)\nSELECT\n  i.period,\n  i.import_value,\n  e.export_value\nFROM imports_cn AS i\nJOIN exports_fr AS e\n  ON i.period = e.period\nWHERE\n  i.import_value > e.export_value\nORDER BY\n  i.period\nLIMIT 1000",

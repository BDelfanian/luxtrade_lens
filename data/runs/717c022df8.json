 "entities": {},
 "insight": [
  "The value of Luxembourg's exports to EU27 countries increased from 12.46 billion euros in 2005 to 13.51 billion euros in 2025.",
  "This represents a growth of 8.4% over the period.",
  "In contrast, exports to non-EU27 countries decreased from 2.94 billion euros in 2005 to 2.74 billion euros in 2025, a decline of 6.5%.",
  "The peak export value to EU27 countries was 14.75 billion euros in 2006, while for non-EU27 countries it was 4.04 billion euros in 2011.",
  "These values are nominal and not adjusted for inflation or price changes."
 ],

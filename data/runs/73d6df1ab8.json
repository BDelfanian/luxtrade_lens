 "sql": "SELECT\n  year,\n  flow,\n  SUM(value_eur) AS value_eur,\n  SUM(qty_kg) AS qty_kg\nFROM v_lu_trade_hs2\nWHERE\n  period >= CAST('2024-01-01' AS DATE)\n  AND period < CAST('2026-01-01' AS DATE)\n  AND partner IN ('US')\nGROUP BY\n  year,\n  flow\nORDER BY\n  year\nLIMIT 10000",

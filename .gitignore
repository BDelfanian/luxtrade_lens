# Environments
.venv/

# Agent skills symlinked into .venv by packages (e.g. Streamlit); machine-local
.agents/skills/developing-with-streamlit
.claude/skills/developing-with-streamlit
.claude/settings.local.json
venv/
env/

# Python
__pycache__/
*.egg-info/
build/
dist/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data (raw downloads are reproducible via python -m luxtrade.ingest.download; never commit them)
data/raw/
data/interim/
*.7z
*.zip

# Streamlit secrets / local config
.streamlit/secrets.toml
.env

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# HTML exports (rendered notebooks, Plotly/Streamlit exports)
*.html
# Quarto/Pandoc HTML render assets
*_files/

# Logs
logs/

# Run records (answers are regenerated or replayed locally; demo runs live in demo/runs/)
data/runs/

# Generated data: placeholder (python -m luxtrade.process.placeholder) or the real pipeline
data/processed/*
!data/processed/.gitkeep

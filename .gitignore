.agents/skills/developing-with-streamlit
.claude/skills/developing-with-streamlit
.claude/settings.local.json
venv/
env/

# Python
__pycache__/
*.egg-info/
build/
dist/
*.py[cod]
.pytest_cache/
.pytest_cache_comext/
.ruff_cache/
.ipynb_checkpoints/

# Data is shared in git so colleagues can run the app right after cloning:
# - data/processed/luxtrade.duckdb, the app's only data source, is stored with Git LFS
#   (see .gitattributes); every other database file stays local.
# - Parquet files (the data/processed contract and the data/interim extracts) are inputs for
#   rebuilding the database, not needed to run the app. Recreate them with
#   python -m luxtrade.ingest.download, then python -m luxtrade.process.build.
# - Bulk .7z archives are deleted after reduction and never committed.
data/**/*.parquet
data/interim/
data/database/
*.duckdb
!data/processed/luxtrade.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.db
*.sqlite
*.sqlite3
*.part
*.7z
*.zip

# Streamlit secrets / local config
.streamlit/secrets.toml
.env

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# HTML exports (rendered notebooks, Plotly/Streamlit exports)
*.html
# Quarto/Pandoc HTML render assets
*_files/

# Logs
logs/

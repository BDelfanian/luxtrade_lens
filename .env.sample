# Copy to .env if you need local overrides; never commit .env.
# DuckDB is a local file database and requires no username/password.
# Any future database credentials must be supplied only here or in the environment.
COMEXT_DATABASE__PATH=data/database/comext.duckdb
COMEXT_DATABASE__MEMORY_LIMIT=1GB
COMEXT_DATABASE__THREADS=1
# Optional overrides:
# COMEXT_DOWNLOAD__START_DATE=2025-01
# COMEXT_DOWNLOAD__END_DATE=2025-12
# COMEXT_DOWNLOAD__DIRECTORY=data/raw
